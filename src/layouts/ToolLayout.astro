---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Faq from '../components/Faq.astro';
import AdSlot from '../components/AdSlot.astro';
import { getRelated, type ToolDefinition } from '../data/registry';
import { breadcrumbLd, faqLd, webApplicationLd } from '../lib/seo';

interface Props {
  tool: ToolDefinition;
}

const { tool } = Astro.props;
const ToolUi = tool.component;
const wide = tool.layout === 'wide';
const related = getRelated(tool);
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Tools', href: '/tools/' },
  { name: tool.name, href: `/tools/${tool.slug}/` },
];
---

<BaseLayout
  title={tool.title}
  description={tool.description}
  ogTitle={tool.ogTitle}
  jsonLd={[
    webApplicationLd(tool),
    faqLd(tool.faqs),
    breadcrumbLd(crumbs),
  ]}
>
  <article class={wide ? 'max-w-5xl' : 'max-w-3xl'}>
    <Breadcrumb items={crumbs} />
    <header class={wide ? 'max-w-3xl' : undefined}>
      <h1 class="font-serif text-4xl leading-tight text-ink sm:text-5xl">{tool.h1}</h1>
      <p class="mt-4 text-lg leading-8">{tool.intro}</p>
    </header>

    <div class="mt-8">
      <ToolUi />
      <p class:list={['tool-disclaimer mt-3 text-sm leading-6 text-muted', wide && 'max-w-3xl']}>{tool.disclaimer}</p>
    </div>

    <div class:list={['mt-8', wide && 'max-w-3xl']}>
      <AdSlot name="after-tool" />
    </div>

    <section id="how-to" class:list={['mt-10', wide && 'max-w-3xl']}>
      <h2 class="font-serif text-2xl text-ink">{tool.howToTitle}</h2>
      <ol class="mt-4 list-decimal space-y-2 pl-5">
        {tool.howTo.map((step) => <li class="pl-1">{step}</li>)}
      </ol>
    </section>

    <section id="features" class:list={['mt-10', wide && 'max-w-3xl']}>
      <h2 class="font-serif text-2xl text-ink">Features</h2>
      <ul class="mt-4 list-disc space-y-2 pl-5">
        {tool.features.map((feature) => <li class="pl-1">{feature}</li>)}
      </ul>
    </section>

    {
      tool.sections.map((section) => (
        <section class:list={['mt-10', wide && 'max-w-3xl']}>
          <h2 class="font-serif text-2xl text-ink">{section.heading}</h2>
          {section.paragraphs.map((paragraph) => (
            <p class="mt-3 leading-7">{paragraph}</p>
          ))}
          {section.subsections?.map((subsection) => (
            <div class="mt-6">
              <h3 class="font-serif text-xl text-ink">{subsection.heading}</h3>
              {subsection.paragraphs.map((paragraph) => (
                <p class="mt-3 leading-7">{paragraph}</p>
              ))}
            </div>
          ))}
        </section>
      ))
    }

    <div class:list={['mt-10', wide && 'max-w-3xl']}>
      <AdSlot name="before-faq" />
    </div>

    <Faq items={tool.faqs} class={wide ? 'max-w-3xl' : undefined} />

    <section id="related-tools" class:list={['mt-12', wide && 'max-w-3xl']}>
      <h2 class="font-serif text-2xl text-ink">Related tools</h2>
      {
        related.length > 0 ? (
          <ul class="mt-4 grid gap-4 sm:grid-cols-2">
            {related.map((item) => (
              <li class="rounded-lg border border-line bg-white p-4">
                <a class="font-serif text-lg text-ink underline-offset-4 hover:underline" href={`/tools/${item.slug}/`}>
                  {item.name}
                </a>
                <p class="mt-2 text-sm leading-6 text-muted">{item.cardBlurb}</p>
              </li>
            ))}
          </ul>
        ) : (
          <>
            <p class="mt-3 leading-7">
              No related tool is listed for this page yet. The directory has the rest of the library.
            </p>
            <ul class="mt-4 list-disc space-y-2 pl-5">
              <li>
                <a class="text-accent underline-offset-4 hover:underline" href="/tools/">
                  Browse the tools directory
                </a>
              </li>
              <li>
                <a class="text-accent underline-offset-4 hover:underline" href="/">
                  Back to the BabelDoc homepage
                </a>
              </li>
            </ul>
          </>
        )
      }
    </section>

    <div class:list={['mt-12', wide && 'max-w-3xl']}>
      <AdSlot name="before-footer" />
    </div>
  </article>
</BaseLayout>
