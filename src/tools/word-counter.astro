---
// Placeholder sample tool. Proves the shared tool-page template.
// Counting rules below match the registry copy for this slug.
---

<div data-word-counter class="rounded-lg border border-line bg-white p-4 sm:p-5">
  <label for="word-counter-text" class="block text-sm font-semibold">Your text</label>
  <textarea
    id="word-counter-text"
    class="mt-2 min-h-48 w-full resize-y rounded-md border border-line bg-paper px-3 py-2 leading-7 text-ink"
    rows="8"
    placeholder="Paste or type your text here."
    autocomplete="off"
    spellcheck="true"
  ></textarea>
  <div class="mt-3">
    <button
      type="button"
      data-action="clear"
      class="inline-flex items-center rounded-md border border-ink px-4 py-2 text-sm font-semibold text-ink hover:bg-ink hover:text-paper"
    >
      Clear text
    </button>
  </div>
  <p class="sr-only" data-count="summary" aria-live="polite"></p>
  <dl class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3">
    <div class="rounded-md bg-soft px-3 py-2">
      <dt class="text-xs font-semibold tracking-wide text-muted uppercase">Words</dt>
      <dd data-count="words" class="font-serif text-2xl tabular-nums">0</dd>
    </div>
    <div class="rounded-md bg-soft px-3 py-2">
      <dt class="text-xs font-semibold tracking-wide text-muted uppercase">Characters</dt>
      <dd data-count="characters" class="font-serif text-2xl tabular-nums">0</dd>
    </div>
    <div class="rounded-md bg-soft px-3 py-2">
      <dt class="text-xs font-semibold tracking-wide text-muted uppercase">No spaces</dt>
      <dd data-count="characters-no-spaces" class="font-serif text-2xl tabular-nums">0</dd>
    </div>
    <div class="rounded-md bg-soft px-3 py-2">
      <dt class="text-xs font-semibold tracking-wide text-muted uppercase">Sentences</dt>
      <dd data-count="sentences" class="font-serif text-2xl tabular-nums">0</dd>
    </div>
    <div class="rounded-md bg-soft px-3 py-2">
      <dt class="text-xs font-semibold tracking-wide text-muted uppercase">Paragraphs</dt>
      <dd data-count="paragraphs" class="font-serif text-2xl tabular-nums">0</dd>
    </div>
    <div class="rounded-md bg-soft px-3 py-2">
      <dt class="text-xs font-semibold tracking-wide text-muted uppercase">Reading time</dt>
      <dd data-count="reading-time" class="font-serif text-2xl tabular-nums">0 min</dd>
    </div>
  </dl>
  <noscript>
    <p class="mt-4 text-sm leading-6">
      Turn on JavaScript to update the counts. The guide and questions further down this page stay readable either way.
    </p>
  </noscript>
</div>

<script>
  function countWords(text: string): number {
    const trimmed = text.trim();
    if (!trimmed) return 0;
    return trimmed.split(/\s+/).length;
  }

  function countCharacters(text: string): number {
    return Array.from(text).length;
  }

  function countCharactersWithoutSpaces(text: string): number {
    return Array.from(text).filter((character) => !/\s/u.test(character)).length;
  }

  function countSentences(text: string): number {
    const trimmed = text.trim();
    if (!trimmed) return 0;
    return trimmed.split(/[.!?]+/).map((part) => part.trim()).filter(Boolean).length;
  }

  function countParagraphs(text: string): number {
    if (!text.trim()) return 0;
    return text
      .split(/\n\s*\n/)
      .map((part) => part.trim())
      .filter(Boolean).length;
  }

  function readingTime(words: number): string {
    if (words === 0) return '0 min';
    if (words <= 200) return 'Under 1 min';
    return `${Math.ceil(words / 200)} min`;
  }

  const roots = document.querySelectorAll('[data-word-counter]');

  for (const root of roots) {
    const input = root.querySelector('textarea');
    const summary = root.querySelector('[data-count="summary"]');
    if (!(input instanceof HTMLTextAreaElement) || !(summary instanceof HTMLElement)) continue;

    const fields = {
      words: root.querySelector('[data-count="words"]'),
      characters: root.querySelector('[data-count="characters"]'),
      charactersNoSpaces: root.querySelector('[data-count="characters-no-spaces"]'),
      sentences: root.querySelector('[data-count="sentences"]'),
      paragraphs: root.querySelector('[data-count="paragraphs"]'),
      readingTime: root.querySelector('[data-count="reading-time"]'),
    };

    const write = (node: Element | null, value: string) => {
      if (node) node.textContent = value;
    };

    const update = () => {
      const text = input.value;
      const words = countWords(text);
      const characters = countCharacters(text);
      const charactersNoSpaces = countCharactersWithoutSpaces(text);
      const sentences = countSentences(text);
      const paragraphs = countParagraphs(text);
      const time = readingTime(words);

      write(fields.words, String(words));
      write(fields.characters, String(characters));
      write(fields.charactersNoSpaces, String(charactersNoSpaces));
      write(fields.sentences, String(sentences));
      write(fields.paragraphs, String(paragraphs));
      write(fields.readingTime, time);
      summary.textContent = `${words} words, ${characters} characters, ${charactersNoSpaces} characters excluding spaces, ${sentences} sentences, ${paragraphs} paragraphs. Reading time: ${time}.`;
    };

    input.addEventListener('input', update);
    root.querySelector('[data-action="clear"]')?.addEventListener('click', () => {
      input.value = '';
      update();
      input.focus();
    });
    update();
  }
</script>
