---
interface Crumb {
  name: string;
  href: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="mb-6">
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-muted">
    {
      items.map((item, index) => {
        const last = index === items.length - 1;
        return (
          <li class="flex items-center gap-2">
            {last ? (
              <span aria-current="page" class="text-ink">
                {item.name}
              </span>
            ) : (
              <a href={item.href} class="text-accent underline-offset-4 hover:underline">
                {item.name}
              </a>
            )}
            {!last && (
              <span aria-hidden="true" class="text-line">
                /
              </span>
            )}
          </li>
        );
      })
    }
  </ol>
</nav>
