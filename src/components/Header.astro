---
import { categories } from '../data/registry';

const pathname = Astro.url.pathname;

const links = [
  ...categories.map((category) => ({
    href: `/#${category.id}`,
    label: category.navLabel,
  })),
  { href: '/tools/', label: 'All Tools' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];

function isCurrent(href: string): boolean {
  if (href.includes('#')) return false;
  if (href === '/') return pathname === '/';
  return pathname === href || pathname.startsWith(href);
}
---

<header class="border-b border-line bg-paper">
  <div class="mx-auto flex w-full max-w-5xl flex-wrap items-center justify-between gap-x-6 gap-y-3 px-5 py-4 sm:px-8">
    <a
      href="/"
      class="inline-flex items-center rounded-md bg-logo px-3 py-1.5 text-base font-semibold tracking-tight text-white"
    >
      BabelDoc
    </a>
    <nav aria-label="Primary" class="max-sm:w-full">
      <ul class="flex flex-wrap gap-x-4 gap-y-2 text-sm sm:gap-x-5">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isCurrent(link.href) ? 'page' : undefined}
                class="text-ink underline-offset-4 hover:underline aria-[current=page]:font-semibold aria-[current=page]:text-accent aria-[current=page]:underline"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
