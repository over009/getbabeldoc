---
import { site } from '../config';

const id = site.gaMeasurementId;
const enabled = /^G-[A-Z0-9]+$/i.test(id);
---

{
  enabled && (
    <>
      <script async is:inline src={`https://www.googletagmanager.com/gtag/js?id=${id}`} />
      <script is:inline define:vars={{ id }}>
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          dataLayer.push(arguments);
        }
        window.gtag = gtag;
        gtag('js', new Date());
        gtag('config', id, {
          page_location: location.origin + location.pathname + location.search,
        });
      </script>
    </>
  )
}
