<div data-export-confirm class="no-print mt-4 rounded-md border border-line bg-paper p-3" hidden>
  <p class="text-sm font-semibold text-ink">These checks did not pass.</p>
  <ul data-export-issues class="mt-2 list-disc space-y-1 pl-5 text-sm leading-6"></ul>
  <div class="mt-3 flex flex-wrap gap-2">
    <button
      type="button"
      data-export-anyway
      class="inline-flex min-h-11 items-center rounded-md border border-ink bg-ink px-4 py-2 text-sm font-semibold text-paper hover:bg-accent"
    >
      Export anyway
    </button>
    <button
      type="button"
      data-export-cancel
      class="inline-flex min-h-11 items-center rounded-md border border-ink px-4 py-2 text-sm font-semibold text-ink hover:bg-ink hover:text-paper"
    >
      Cancel
    </button>
  </div>
</div>
