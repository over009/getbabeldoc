{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "getbabeldoc",
  "routes": [{ "pattern": "getbabeldoc.com", "custom_domain": true }],
  "compatibility_date": "2026-11-19",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Wrangler runs this before `deploy` and `preview`. Pull request builds invoke
  // `npx wrangler preview` with no separate build step, so this is what creates dist/.
  "build": {
    "command": "npm run build"
  },
  // Workers Builds runs `npx wrangler preview` on pull requests. The block can be empty.
  "previews": {}
}
